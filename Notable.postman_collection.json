{
  "info": {
    "name": "Notable Django API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Локальная сессия Django: сначала выполнить обе команды входа. Cookie jar должен быть включён. Изменяющие запросы передают CSRF-токен."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "noteUrl",
      "value": ""
    },
    {
      "key": "username",
      "value": "student1"
    },
    {
      "key": "password",
      "value": "PracticeDemo2026!"
    }
  ],
  "item": [
    {
      "name": "0a. Get login form and CSRF cookie",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/accounts/login/"
      }
    },
    {
      "name": "0b. Log in (save session cookie)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/accounts/login/",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "username",
              "value": "{{username}}"
            },
            {
              "key": "password",
              "value": "{{password}}"
            },
            {
              "key": "csrfmiddlewaretoken",
              "value": "{{csrf}}"
            }
          ]
        }
      }
    },
    {
      "name": "1. List notes",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/note/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP status', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Create note",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/note/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Demo note\",\n  \"body\": \"Created in Postman\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP status', () => pm.response.to.have.status(201));",
              "const location = pm.response.headers.get('Location');",
              "if (location) pm.collectionVariables.set('noteUrl', location.startsWith('http') ? location : pm.collectionVariables.get('baseUrl') + location);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Read created note",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{noteUrl}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP status', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Update created note",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{noteUrl}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated note\",\n  \"body\": \"Updated in Postman\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP status', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Verify update",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{noteUrl}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP status', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Delete created note",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{noteUrl}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP status', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const token = pm.cookies.get('csrftoken');",
          "if (token) { pm.variables.set('csrf', token); pm.request.headers.upsert({key: 'X-CSRFToken', value: token}); }"
        ]
      }
    }
  ]
}
